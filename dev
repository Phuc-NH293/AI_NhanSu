#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -ExecutionPolicy Bypass -File "$SCRIPT_DIR/start_all.ps1" "$@"
fi

if command -v powershell >/dev/null 2>&1; then
  exec powershell -ExecutionPolicy Bypass -File "$SCRIPT_DIR/start_all.ps1" "$@"
fi

echo "PowerShell was not found. Install PowerShell, then run ./dev again." >&2
exit 1
