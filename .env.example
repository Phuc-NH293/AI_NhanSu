# LLM provider
LLM_PROVIDER=gemini
LLM_MODEL=

# Gemini (recommended for this project)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# OpenAI (optional alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Production auth/admin
# Auth uses standard HS256 JWT bearer tokens.
AUTH_SECRET=change-me-to-a-long-random-secret
ADMIN_EMAIL=admin@lesson.local
ADMIN_PASSWORD=change-me-before-production
ADMIN_NAME=Quan tri vien
AUTH_TOKEN_TTL_SECONDS=604800
ALLOW_PUBLIC_REGISTRATION=0
CORS_ORIGINS=http://localhost:5173

# Jina AI (Task 7 - Reranking, optional)
JINA_API_KEY=jina_xxx
ENABLE_CROSS_ENCODER=0
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# RAG chunking: small atomic policy clauses with heading context
RAG_CHUNK_SIZE=420
RAG_CHUNK_OVERLAP=60

# Enterprise integrations
HRM_API_BASE=
HRM_API_TOKEN=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# PageIndex (Task 8 - Vectorless RAG)
PAGEINDEX_API_KEY=pi_xxx

# Weaviate Cloud (Task 4, optional - can use local Docker instead)
WEAVIATE_URL=https://xxx.weaviate.network
WEAVIATE_API_KEY=xxx

# Embedding model (if using API-based)
# COHERE_API_KEY=xxx

# Email configuration for registration and password reset emails
# Resend is recommended on Railway because SMTP can be blocked.
# RESEND_API_KEY=re_xxx
# RESEND_SENDER=HR Helpdesk AI <onboarding@resend.dev>

# OCR for scanned PDFs or image-only slides
OCR_ENABLED=0
OCR_PROVIDER=gemini
OCR_MODEL=
OCR_MAX_PAGES=40

# Optional SMTP fallback for local/dev usage
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_SENDER=your-email@gmail.com
